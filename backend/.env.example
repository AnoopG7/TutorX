# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq
GROQ_API_KEY=your-groq-api-key

# Frontend origins allowed by CORS (comma-separated, no trailing slash needed)
CORS_ORIGINS=http://localhost:5173
# Optional: regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=^https://tutor-[a-z0-9]+-your-team\.vercel\.app$

# Where password-reset emails send people. Also add {FRONTEND_URL}/reset-password
# to Supabase → Authentication → URL Configuration → Redirect URLs.
FRONTEND_URL=http://localhost:5173

# Query embeddings — must be nomic-embed-text (768-dim), the model the chunks were ingested with.
#   ollama: local or hosted Ollama        nomic: Nomic's hosted API (use this on Render)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# NOMIC_API_KEY=your-nomic-api-key

# Only for scripts/chat_cli.py: lets POST /api/chat take user_id in the body without a token.
# Never enable in production.
ALLOW_INSECURE_DEV_AUTH=false

# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-api-domain/webhook/telegram

# Environment
ENVIRONMENT=development
DEBUG=true
